# Copy to backend/.env and fill in what you need. backend/.env overrides a
# repo-root .env. Every variable below is optional unless marked required.

# --- Database (required for anything beyond the mock data) ---
# postgresql:// and postgres:// URLs are converted to the asyncpg driver.
# SUPABASE_DB_URL or SUPABASE_DATABASE_URL are accepted as fallbacks.
DATABASE_URL=postgresql://user:password@localhost:5432/postgres
DB_SSL_REQUIRE=true

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- LLM providers (required for claims, personas, simulation and reports) ---
# Lava proxies Gemini and Apollo. LAVA_KEY is accepted as a fallback name.
LAVA_API_KEY=your-lava-key
# K2 Think. Falls back to TOGETHER_API_KEY (or TOGETHER_KEY) when unset.
K2_API_KEY=your-k2-key
TOGETHER_API_KEY=
# Override the Lava forward URLs (defaults point at Gemini and Apollo).
LAVA_CHAT_COMPLETIONS_URL=
LAVA_APOLLO_URL=
LLM_TIMEOUT_SECONDS=60
SIM_AGENT_TIMEOUT_SECONDS=8

# --- Polymarket ---
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_TIMEOUT_SECONDS=10
POLYMARKET_MAX_RETRIES=3

# --- App ---
APP_NAME=Prediction Market Analyzer API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000
LENIENT_CORS=true
